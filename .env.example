# Guild Book — Environment Variables

# Auth (required for production)
AUTH_SECRET=generate-a-random-secret-here
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Set to true to enable the dev-only Credentials login provider (also requires
# NODE_ENV=development). Off by default so a leaked dev deployment cannot
# accept arbitrary email logins.
AUTH_DEV_LOGIN=false

# Dev-only auto-login pass-through. Skips the /login screen entirely and signs
# you in as `dev@local` on first request. Requires NODE_ENV=development AND the
# gitignored src/lib/server/dev-auto-login.ts file (copy from
# dev-auto-login.example.ts to enable). Off by default. NEVER set true in
# production — even if set, the bypass file is gitignored and absent there.
AUTH_DEV_AUTOLOGIN=false

# Database (default: local.db in project root)
DATABASE_URL=local.db

# Campaign foundation rollout (server-only; disabled by default). Access is
# granted when CAMPAIGNS_ENABLED is true OR the signed-in user's id is in
# CAMPAIGNS_PILOT_USER_IDS (comma-separated Guild Book user ids, not emails).
# For an allowlisted pilot, keep CAMPAIGNS_ENABLED=false and populate only
# the pilot list — see docs/operations/campaign-pilot.md for how to look up
# a pilot user's id, the session start/freeze/recover/end operator flow, the
# privacy incident response, and the feature-disable rollback (both scopes:
# revoke one id, or clear the pilot entirely).
CAMPAIGNS_ENABLED=false
CAMPAIGNS_PILOT_USER_IDS=
CAMPAIGN_INVITE_SECRET=generate-a-dedicated-campaign-invite-secret

# Campaign rate limiting is a Cloudflare BINDING, not an environment variable —
# there is nothing to set here. The four `[[ratelimits]]` bindings in
# wrangler.toml (session commands, campaign mutations, invite joins, session
# polling) are injected by the Workers runtime; note their counters are per
# Cloudflare location, not global.
#
# Off the edge — `npm run dev`, `npm run preview`, Vitest, Playwright — no
# binding exists and an in-memory limiter stands in as development defence.
# On Cloudflare with NODE_ENV unset or not "development", a MISSING binding is
# treated as a misconfiguration: campaign mutations fail closed with 503 while
# polls are served degraded, rather than silently running unlimited.

# Internal campaign health check (server-only; optional). When unset,
# /api/internal/campaign-health does not exist — it answers 404 to everyone,
# including a caller presenting a token. When set, the endpoint accepts
# `Authorization: Bearer <this value>`, compared in constant time, and returns
# AGGREGATE operations data only (feature flag, allowlist size, D1
# reachability, migration count, content digest, rate-limit binding presence,
# active/frozen session counts, oldest frozen age). Use a dedicated random
# value — never reuse AUTH_SECRET or CAMPAIGN_INVITE_SECRET.
CAMPAIGN_HEALTH_SECRET=

# Admin oversight (server-only; optional). Comma-separated email addresses of
# users permitted to access /admin. Matched against the stored users.email
# column (OAuth-linked addresses), not the session claim. Unset or empty means
# nobody can reach /admin.
ADMIN_EMAILS=

# Feedback link (optional). URL where the alpha banner's "Send feedback" link and
# the error page's feedback link point. Omit or leave empty to hide the link.
FEEDBACK_URL=

# Build/server
ADAPTER=auto
NODE_ENV=development
ORIGIN=http://localhost:5173
PORT=3000
